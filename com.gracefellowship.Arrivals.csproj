<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>com.gracefellowship.Arrivals</AssemblyName>
    <RootNamespace>com.gracefellowship.Arrivals</RootNamespace>
    <Description>Children's ministry pickup-notification billboard plugin for Rock RMS</Description>
    <Company>Grace Fellowship</Company>
    <Version>1.0.0</Version>
    <!--
      RockBinPath points to the folder containing Rock.dll, EntityFramework.dll, etc.
      Override at build time with: /p:RockBinPath=C:\other\path\bin
    -->
    <RockBinPath Condition="'$(RockBinPath)' == ''">C:\inetpub\wwwroot\Rock\Bin</RockBinPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Rock references — Copy Local = false because they already live in Rock's bin folder.
      Shipping duplicates causes load conflicts.

      NOTE (v19): Rock.Lava.Shared.dll and DotLiquid.dll are no longer shipped as of
      Rock RMS v19 (the DotLiquid -> Fluid Lava transition is complete). They must
      NOT be referenced here, or the plugin DLL will fail to load.

      This plugin reads Rock Check-in data directly (Attendance, AttendanceCode,
      AttendanceOccurrence, Device) via EF/RockContext. Unlike the sibling PCOMigration
      plugin, it does NOT bulk-import via Slingshot, so Rock.Slingshot / Slingshot.Core
      / CsvHelper are intentionally NOT referenced.
    -->
    <Reference Include="Rock">
      <HintPath>$(RockBinPath)\Rock.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntityFramework">
      <HintPath>$(RockBinPath)\EntityFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Standard .NET Framework references -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json — match version bundled with Rock 19 (13.x). Used for the polling
         endpoint's lightweight JSON DTOs. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <Private>false</Private>
    </PackageReference>
  </ItemGroup>

  <!-- Treat .ascx files as Content so they appear in the project and ship in the .plugin -->
  <ItemGroup>
    <Content Include="Blocks\**\*.ascx" />
  </ItemGroup>

  <!--
    Post-build: copy the plugin DLL and .ascx blocks into the Rock install.
    Uncomment when ready to deploy directly from build. Remember: DLL -> bin\,
    .ascx -> Plugins\...\Blocks\ (NEVER the reverse — see .context/LESSONS.md L1).
  -->
  <!--
  <Target Name="DeployToRock" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(RockBinPath)\" />
    <Copy SourceFiles="Blocks\ArrivalsAdmin.ascx"
          DestinationFolder="$(RockBinPath)\..\Plugins\com_gracefellowship_Arrivals\Blocks\" />
  </Target>
  -->

</Project>
